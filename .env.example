# Public IVR configuration
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app
DRE_URL=http://localhost:3000/api/v1/match

# Speech provider and Twilio recording authentication
SPEECH_PROVIDER=bhashini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Bhashini ASR (copy the proven service ID into the blank setting)
BHASHINI_ENABLED=true
BHASHINI_UDYAT_KEY=
BHASHINI_UDYAT_KEY_NAME=userID
BHASHINI_INFERENCE_KEY=
BHASHINI_INFERENCE_KEY_NAME=Authorization
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_ASR_SERVICE_ID=
# Optional overrides when Hindi and English use different pipeline service IDs
BHASHINI_ASR_SERVICE_ID_HI=
BHASHINI_ASR_SERVICE_ID_EN=
BHASHINI_REQUEST_TIMEOUT_SECONDS=30

# Audio recording and conversion
TWILIO_RECORD_MAX_SECONDS=15
TWILIO_RECORD_SILENCE_TIMEOUT=3
TWILIO_RECORD_FINISH_KEY="#"
FFMPEG_BIN=ffmpeg

# Location and existing IVR behavior
PINCODE_API_URL=https://api.postalpincode.in/pincode/{pincode}
SESSION_TTL_SECONDS=1200
MAX_CONVERSATION_TURNS=15
MAX_FIELD_RETRIES=2
LOW_STT_CONFIDENCE=0.35
IVR_TARGET_MAX_CALLBACKS=9
IVR_DEBUG=true
